# -- Configuration for newsboat for general-purpose reading ------------

# config, cache, log paths set by wrapper script
# Also path to scripts for newsbeuter_dangerzone is added for shell by wrapper script

# -- General -----------------------------------------------------------
cookie-cache ""
opml-url ""

# -- GUI ---------------------------------------------------------------
show-keymap-hint yes
selecttag-format "[%2i] %T (%n unread articles in %f feeds, %u feeds total)"

# -- TinyTinyRss -------------------------------------------------------

# ^E is flag
ttrss-flag-star "s"
ttrss-flag-publish "p"
prepopulate-query-feeds yes

# -- Updating ----------------------------------------------------------
refresh-on-startup no
suppress-first-reload yes
auto-reload yes
reload-threads 10
reload-time 120
download-full-page yes
download-path "/home/steven/downloads"

# hide articles matching: ---------------------------------------------
ignore-article "*" "title =~ \"Sponsor\""
ignore-article "*" "title =~ \"Advertisement\""
ignore-mode "display"

# -- Purging ----------------------------------------------------------
keep-articles-days 30
cleanup-on-quit yes
delete-read-articles-on-quit yes
max-items 50

# -- Displaying ----------------------------------------------------------
browser "tmux neww elinks %u"
display-article-progress yes
feed-sort-order unreadarticlecount-desc
show-read-feeds no
text-width 120

html-renderer "renderer_links.sh"
external-url-viewer "urlview"



# -- Bookmarks ---------------------------------------------------------
bookmark-cmd "bookmark.sh"
bookmark-interactive yes
bookmark-autopilot no

# -- Macros -----------------------------------------------------------
# TODO - set the environment variable instead of calling different programs
# Also, we're always exporting the links anyway....
macro Y set set html-renderer "export show_links=true;renderer.sh"
macro y set html-renderer "export show_links=false;renderer.sh"
macro R set show-read-feeds yes
macro r set show-read-feeds no

