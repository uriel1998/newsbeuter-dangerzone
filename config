# -- Keybindings -------------------------------------------------------

unbind-key r all
unbind-key j all
unbind-key k all
unbind-key NPAGE all
unbind-key PPAGE all
unbind-key \ all
unbind-key / all

bind-key LEFT quit
bind-key RIGHT open
bind-key "SPACE" open
bind-key r toggle-article-read
bind-key p prev-unread
bind-key n next-unread
#bind-key p prev feedlist
bind-key \ set-tag
bind-key k next-unread-feed
bind-key j prev-unread-feed
bind-key NPAGE next-unread-feed
bind-key PPAGE prev-unread-feed
bind-key ] next-unread-feed
bind-key [ prev-unread-feed
bind-key / select-tag
unbind-key       R
bind-key         ^R    reload-all
bind-key        R   reload



# -- Colors ---------------------------------------------
color background          color240   default
color listnormal          color245   default
color listnormal_unread   color251   default
color listfocus           color229   color61 bold
color listfocus_unread    color229   color61 bold
color info                color247   color235
color article             color251   default

# highlights
highlight article "^(Feed|Link):.*$" color46 default
highlight article "^(Title|Date|Author):.*$" color39 default
highlight article "https?://[^ ]+" green default
highlight article "](.+@.+) " cyan default
highlight article "\\[[0-9]+\\]" color63 default bold
highlight article "\\[image\\ [0-9]+\\]" color63 default bold
highlight article "⬞.+⬞" color3 default
highlight article "Flags: p" color60 default
highlight article "Flags: ps" color63 default
highlight feedlist "^─.*$" color61 color235 bold

external-url-viewer "urlview"
bind-key U show-urls
